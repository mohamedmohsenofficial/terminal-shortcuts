#!/usr/bin/env bash

# --------------------------------------------------
# Update Terminal Shortcuts
# --------------------------------------------------

echo "Running some updates to keep Terminal Shortcuts healthy... 😚"

if command -v update-terminal-shortcuts >/dev/null 2>&1; then
    update-terminal-shortcuts >/dev/null 2>&1 || true
fi

echo

# Colors
RED='\033[1;31m'; GREEN='\033[1;32m'; YELLOW='\033[1;33m'; CYAN='\033[1;36m'; WHITE='\033[1;37m'; NC='\033[0m'
GRAY='\033[1;30m'

# Main Application Loop
while true; do
    clear
    echo -e "${CYAN}========================================${NC}\n"
    echo -e "  macOS Master Updater & Cleaner\n"
    echo -e "${CYAN}========================================${NC}\n"

    # 1. Checking Dependencies
    echo -e "  ${YELLOW}[1/4]${NC} Checking required update modules...\n"

    if ! command -v brew &> /dev/null; then
        echo -e "    - ${YELLOW}Homebrew not found. App updates will be limited.${NC}\n"
    fi

    if ! command -v mas &> /dev/null && command -v brew &> /dev/null; then
        echo -e "    - ${CYAN}Installing 'mas' (Mac App Store CLI)...${NC}\n"
        brew install mas >/dev/null 2>&1
    fi

    # 2. Scanning for Updates
    echo -e "  ${YELLOW}[2/4]${NC} ${CYAN}Scanning${NC} for OS and App updates...\n"

    echo -e "  Checking macOS System Updates:\n"
    SW_UPDATE=$(softwareupdate -l 2>/dev/null | grep -E "Software Update found|Title|Version" | sed 's/^/    - /')
    if [ -n "$SW_UPDATE" ]; then
        echo -e "$SW_UPDATE\n"
    else
        echo -e "    - ${GREEN}[OK] macOS is up to date.${NC}\n"
    fi

    echo -e "  Checking App Updates (App Store):\n"
    if command -v mas &> /dev/null; then 
        MAS_UPDATE=$(mas outdated 2>/dev/null | sed 's/^/    - /')
        if [ -n "$MAS_UPDATE" ]; then
            echo -e "$MAS_UPDATE\n"
        else
            echo -e "    - ${GREEN}[OK] App Store apps are up to date.${NC}\n"
        fi
    else 
        echo -e "    - ${GRAY}(mas CLI not installed)${NC}\n"
    fi

    echo -e "  Checking App Updates (Homebrew):\n"
    if command -v brew &> /dev/null; then 
        BREW_UPDATE=$(brew outdated 2>/dev/null | sed 's/^/    - /')
        if [ -n "$BREW_UPDATE" ]; then
            echo -e "$BREW_UPDATE\n"
        else
            echo -e "    - ${GREEN}[OK] Homebrew apps are up to date.${NC}\n"
        fi
    else 
        echo -e "    - ${GRAY}(Homebrew not installed)${NC}\n"
    fi

    # 3. User Confirmation Phase
    echo -e "${CYAN}========================================${NC}\n"
    echo -e "  1. ${GREEN}Approve${NC} & ${GREEN}Update${NC} Everything (OS + Apps)\n"
    echo -e "  0. ${WHITE}Skip${NC} / ${RED}Cancel${NC} Updates (Move to Cleanup)\n"
    
    read -p "  Choice (0-1): " choice_update
    echo -e "\n"

    if [[ "$choice_update" == "1" ]]; then
        
        # Executing Updates
        echo -e "  ${YELLOW}[3/4]${NC} Executing ${GREEN}Updates${NC}...\n"
        
        echo -e "  Updating macOS System...\n"
        sudo softwareupdate -i -a
        echo -e "\n  ${GREEN}[OK] System updated successfully!${NC}\n"
        
        if command -v mas &> /dev/null; then
            echo -e "  Updating App Store Apps...\n"
            mas upgrade
        fi
        
        if command -v brew &> /dev/null; then
            echo -e "  Updating Homebrew Apps...\n"
            brew upgrade
        fi
        
        echo -e "\n  ${GREEN}[OK] Apps updated successfully!${NC}\n"
        
    elif [[ "$choice_update" == "0" ]]; then
        echo -e "  ${WHITE}[SKIPPED]${NC} Pending updates were skipped. Moving to next step...\n"
    else
        echo -e "  ${RED}[ERROR] Invalid choice. Moving to next step...${NC}\n"
    fi

    # 4. Cleanup Phase
    echo -e "${CYAN}========================================${NC}\n"
    echo -e "  ${YELLOW}[4/4]${NC} System Cleanup & Cache Rebuild\n"
    echo -e "  1. ${GREEN}Approve${NC} & ${RED}Clean${NC} Update Garbage & Leftovers\n"
    echo -e "  0. ${WHITE}Skip${NC} / ${RED}Cancel${NC} Cleanup (Move to Report)\n"
    
    read -p "  Choice (0-1): " choice_clean
    echo -e "\n"

    if [[ "$choice_clean" == "1" ]]; then
        echo -e "  Cleaning Update ${RED}Garbage${NC} & Leftovers...\n"
        
        if command -v brew &> /dev/null; then 
            brew cleanup -s
        fi
        
        sudo rm -rf /Library/Updates/* 2>/dev/null
        
        echo -e "  ${GREEN}[OK] Cleanup completed. Caches cleared!${NC}\n"
    else
        echo -e "  ${WHITE}[SKIPPED]${NC} Cleanup was skipped. Moving to report...\n"
    fi

    # 5. Final Report & Loop Prompt
    echo -e "${CYAN}========================================${NC}\n"
    echo -e "  ${GREEN}[OK] Master Operation Cycle Complete!${NC}\n"
    echo -e "${CYAN}========================================${NC}\n"

    echo -e "What would you like to do next?"
    echo -e "  1. ${GREEN}Run Updater & Cleaner Again${NC}"
    echo -e "  0. ${RED}Exit${NC}\n"
    
    read -p "  Choice (0-1): " loop_choice
    echo -e "\n"

    if [[ "$loop_choice" == "0" ]]; then
        echo -e "  ${GREEN}Goodbye!${NC}\n"
        break
    fi
done
